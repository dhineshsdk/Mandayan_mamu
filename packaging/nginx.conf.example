# TLS in front of Sutra. Sutra listens on 127.0.0.1:8765 only; this is the only thing the network should reach.
# Adjust server_name and the certificate paths (an internal CA certificate is fine).

server {
    listen 80;
    server_name sutra.plant.example.in;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name sutra.plant.example.in;

    ssl_certificate     /etc/ssl/sutra/fullchain.pem;
    ssl_certificate_key /etc/ssl/sutra/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 300m;          # scanner exports; matches Sutra's own upload limit
    server_tokens off;

    location / {
        proxy_pass         http://127.0.0.1:8765;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_read_timeout 300s;
    }
}
