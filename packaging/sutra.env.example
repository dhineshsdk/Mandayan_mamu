# Sutra settings. Read by the service (systemd EnvironmentFile) and by `python -m sutra ...` run with this environment.
# Keep this file private (root:sutra, mode 640). It holds the server secret.

SUTRA_WORKSPACE=@DATA@
SUTRA_SECRET_KEY=@SECRET@
SUTRA_BACKUP_DIR=@BACKUPS@

# The address people use, behind your TLS proxy. Required for links in notifications and tickets.
#SUTRA_BASE_URL=https://sutra.plant.example.in

# Licence: with 1, nothing but Administration runs until a licence key is installed.
SUTRA_REQUIRE_LICENCE=1

# Data stays on this server and inside your network. Only hosts named here may be contacted (private network
# addresses are always allowed). Examples: jira.example.in,*.teams.example.in,10.20.0.0/16
SUTRA_EGRESS=allowlist
SUTRA_EGRESS_ALLOW=

# No internet feeds by default. To refresh CISA KEV / FIRST EPSS, point these at a mirror inside your network.
SUTRA_INTEL_REFRESH=0
#SUTRA_KEV_URL=http://mirror.plant.example.in/kev.json
#SUTRA_EPSS_URL=http://mirror.plant.example.in/epss

# AI: off unless you choose a model. A model inside your network (an OpenAI-compatible server):
#SUTRA_AI_PROVIDER=local
#SUTRA_AI_LOCAL_URL=http://10.20.0.30:8000/v1
#SUTRA_AI_LOCAL_MODEL=your-model-name
SUTRA_AI_PROVIDER=off

# Single sign-on (recommended; your identity provider's MFA then applies).
#SUTRA_OIDC_ISSUER=https://login.example.in/realms/plant
#SUTRA_OIDC_CLIENT_ID=sutra
#SUTRA_OIDC_CLIENT_SECRET=
#SUTRA_ALLOW_LOCAL_LOGIN=0

# Cookies are Secure (HTTPS only). Never turn this off outside a developer laptop.
SUTRA_COOKIE_SECURE=1
